{
  "pluginApiVersion": 1,
  "id": "salvage-plugin-anilist",
  "name": "AniList",
  "version": "0.11.4",
  "runtime": { "entry": "dist/plugin.js" },
  "provides": [],
  "contributes": [
    {
      "id": "episodes",
      "slot": "entry.detail.link.action",
      "when": { "link.host": ["anilist.co"] },
      "ui": { "kind": "button", "label": "Episodes", "icon": "list" },
      "view": "episodes",
      "command": "episodes",
      "timeoutMs": 30000
    }
  ],
  "canvas": {
    "command": "catalogue",
    "name": "Anime",
    "icon": "film",
    "refreshMs": 21600000,
    "settings": [
      {
        "key": "type",
        "kind": "select",
        "label": "Anime or manga",
        "default": "ANIME",
        "options": [
          { "value": "ANIME", "label": "Anime" },
          { "value": "MANGA", "label": "Manga" }
        ]
      },
      {
        "key": "list",
        "kind": "select",
        "label": "Which list",
        "description": "Popular and trending are the same for everyone. Personal reads your own lists.",
        "default": "trending",
        "options": [
          { "value": "trending", "label": "Trending now" },
          { "value": "popular", "label": "Most popular" },
          { "value": "top", "label": "Top rated" },
          { "value": "personal", "label": "Personal", "needsAuth": true }
        ]
      },
      {
        "key": "lists",
        "kind": "multiselect",
        "label": "Which of my lists",
        "description": "Only the items on these lists are shown. Nothing ticked means all of them.",
        "when": { "list": ["personal"] },
        "default": "WATCHING,COMPLETED,PLANNING",
        "options": [
          { "value": "WATCHING", "label": "Watching" },
          { "value": "COMPLETED", "label": "Completed" },
          { "value": "PLANNING", "label": "Planning" },
          { "value": "PAUSED", "label": "Paused" },
          { "value": "DROPPED", "label": "Dropped" },
          { "value": "REPEATING", "label": "Rewatching" }
        ]
      },
      {
        "key": "perPage",
        "kind": "number",
        "label": "How many entries",
        "description": "The canvas asks for this many at a time and loads more as you scroll.",
        "default": 30,
        "min": 5,
        "max": 50
      }
    ]
  },
  "settings": [
    {
      "key": "clientId",
      "kind": "text",
      "label": "AniList app id",
      "description": "Create an app on AniList and paste the id it is given. Only needed to sign in.",
      "maxLength": 20,
      "default": ""
    },
    {
      "key": "token",
      "kind": "secret",
      "label": "AniList token",
      "maxLength": 200
    }
  ],
  "auth": {
    "url": "https://anilist.co/settings/developer",
    "urlLabel": "AniList developer settings",
    "callbackPath": "/v1/plugins/salvage-plugin-anilist/oauth/callback",
    "authorize": "https://anilist.co/api/v2/oauth/authorize?client_id={clientId}&response_type=token",
    "clientIdKey": "clientId",
    "secret": "token",
    "check": "whoami",
    "note": "Sign in on this computer only. AniList sends the token to the helper here, which keeps it beside the plugin; nothing about it reaches your account."
  }
}
