{
  "pluginApiVersion": 1,
  "id": "salvage-plugin-anilist",
  "name": "AniList",
  "version": "0.1.0",
  "runtime": { "entry": "dist/plugin.js" },
  "provides": [],
  "contributes": [],
  "canvas": {
    "command": "catalogue",
    "name": "Anime",
    "icon": "film",
    "refreshMs": 21600000
  },
  "settings": [
    {
      "key": "type",
      "kind": "select",
      "label": "Anime or manga",
      "default": "ANIME",
      "options": [
        { "value": "ANIME", "label": "Anime" },
        { "value": "MANGA", "label": "Manga" }
      ]
    },
    {
      "key": "list",
      "kind": "select",
      "label": "Which list",
      "default": "trending",
      "options": [
        { "value": "trending", "label": "Trending now" },
        { "value": "popular", "label": "Most popular" },
        { "value": "top", "label": "Top rated" }
      ]
    },
    {
      "key": "perPage",
      "kind": "number",
      "label": "How many entries",
      "default": 30,
      "min": 5,
      "max": 50
    }
  ]
}
